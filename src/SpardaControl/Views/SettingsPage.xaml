<UserControl x:Class="SpardaControl.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InfoKey" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Energia" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" Text="Depois desse tempo parado o mouse entra em modo de espera para economizar bateria."/>
                    <Grid>
                        <TextBlock Text="Dormir após" Style="{StaticResource Label}"/>
                        <ComboBox Width="160" HorizontalAlignment="Right" ItemsSource="{Binding SleepOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SleepTime}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasLongDistance, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Conexão sem fio" Style="{StaticResource H2}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LongDistance}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Modo longa distância" FontSize="13"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Aumenta a potência e a resistência a interferência quando o mouse está longe do receptor. A bateria dura menos."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Parear receptor" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                               Text="Para usar um receptor novo: ligue o mouse, segure os botões esquerdo, direito e do meio juntos por 3 segundos até a luz piscar, aproxime o mouse do receptor e clique em Iniciar."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Iniciar pareamento" Style="{StaticResource PrimaryButton}" Click="Pair_Click"
                                IsEnabled="{Binding IsPairing, Converter={StaticResource InvBool}}"/>
                        <TextBlock Text="{Binding PairStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Dispositivo" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Modelo" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoModel}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Grid.Row="1" Text="Sensor" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InfoSensor}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Grid.Row="2" Text="Conexão" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InfoConnection}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Grid.Row="3" Text="Receptor" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InfoReceiver}" Style="{StaticResource InfoValue}" TextTrimming="CharacterEllipsis" Margin="16,7,0,7"/>
                        <TextBlock Grid.Row="4" Text="Firmware do mouse" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InfoMouseFw}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Grid.Row="5" Text="Firmware do receptor" Style="{StaticResource InfoKey}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InfoDongleFw}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Sobre" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" FontSize="12.5"
                               Text="Sparda Control 1.0 · configurador offline. Funciona sem internet e grava as configurações direto na memória do mouse, igual ao configurador web."/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="12.5" x:Name="DataFolderText"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
