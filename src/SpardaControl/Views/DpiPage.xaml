<UserControl x:Class="SpardaControl.Views.DpiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Estágios de DPI" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="Clique em um estágio para ativá-lo e editar. O botão de DPI do mouse alterna entre eles."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="Quantidade" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding DpiStageCountOptions}" SelectedValue="{Binding DpiStageCount}"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding DpiStages}" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Margin="0,0,10,0" CornerRadius="12" Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1.5" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="Stage_Click" Tag="{Binding}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Number, StringFormat=DPI {0}}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                        <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" Cursor="Hand"
                                                Background="{Binding Color, Converter={StaticResource ColorToBrush}}" BorderBrush="#50FFFFFF" BorderThickness="1"
                                                MouseLeftButtonUp="Color_Click" Tag="{Binding}" ToolTip="Cor deste estágio"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Value, StringFormat=N0}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0" Background="{Binding Color, Converter={StaticResource ColorToBrush}}" Opacity="0.85"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Card" Property="Background" Value="#1F1416"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,16,0,0" Background="#121317" CornerRadius="12" Padding="18,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{Binding SelectedStage.Number, StringFormat=EDITANDO DPI {0}}" Style="{StaticResource Overline}"/>
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                                <Run Text="{Binding SelectedDpi, StringFormat=N0, Mode=OneWay}"/><Run Text=" DPI" FontSize="14" Foreground="{StaticResource TextDimBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Slider Minimum="{Binding DpiMin}" Maximum="{Binding DpiMax}" Value="{Binding SelectedDpi, Delay=0}" SmallChange="10" LargeChange="100"/>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding DpiMin, StringFormat=N0}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding DpiMax, StringFormat=N0}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                            <Button Content="−" Width="36" Height="36" Padding="0" FontSize="16" Click="Minus_Click"/>
                            <TextBox Width="92" Margin="8,0" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                     Text="{Binding SelectedDpiText, UpdateSourceTrigger=LostFocus}" KeyDown="DpiBox_KeyDown"/>
                            <Button Content="+" Width="36" Height="36" Padding="0" FontSize="16" Click="Plus_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Polling rate" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                   Text="Quantas vezes por segundo o mouse informa a posição ao PC (Hz). Taxas altas gastam mais bateria."/>
                        <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding ReportRateOptions}" SelectedValue="{Binding ReportRate}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasDpiEffect, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Indicador de DPI" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" Text="Luz que mostra a cor do estágio de DPI ativo."/>
                        <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding DpiEffectOptions}" SelectedValue="{Binding DpiEffectMode}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Brilho" Style="{StaticResource Label}"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                    Value="{Binding DpiEffectBrightness}" IsEnabled="{Binding DpiBrightnessEnabled}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DpiEffectBrightness}" HorizontalAlignment="Right" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Row="1" Text="Velocidade" Style="{StaticResource Label}"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                    Value="{Binding DpiEffectSpeed}" IsEnabled="{Binding DpiSpeedEnabled}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DpiEffectSpeed}" HorizontalAlignment="Right" Style="{StaticResource Label}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasSensorCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Sensor" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8" Text="Ajustes finos do sensor óptico."/>

                    <StackPanel Visibility="{Binding HasSensorMode, Converter={StaticResource BoolToVis}}" Margin="0,8,0,4">
                        <TextBlock Text="Modo do sensor" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding SensorModeOptions}" SelectedValue="{Binding SensorMode}"
                                 IsEnabled="{Binding SensorModeEditable}"/>
                        <TextBlock Text="{Binding SensorModeNote}" Style="{StaticResource Caption}" Visibility="{Binding SensorModeNote, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasLod, Converter={StaticResource BoolToVis}}" Margin="0,12,0,4">
                        <TextBlock Text="LOD (altura de corte)" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding LodOptions}" SelectedValue="{Binding Lod}"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,6"/>

                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MotionSync}" Margin="0,8"
                              Visibility="{Binding HasMotionSync, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Motion Sync" FontSize="13"/>
                            <TextBlock Text="Sincroniza a leitura do sensor com o polling (movimento mais consistente)." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Ripple}" Margin="0,8"
                              Visibility="{Binding HasRipple, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Ripple control" FontSize="13"/>
                            <TextBlock Text="Suaviza tremidas em DPI muito alto." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AngleSnap}" Margin="0,8"
                              Visibility="{Binding HasAngle, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Angle snapping" FontSize="13"/>
                            <TextBlock Text="Corrige linhas retas automaticamente. Normalmente desligado para jogos." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Visibility="{Binding HasPerformance, Converter={StaticResource BoolToVis}}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PerformanceState}" Margin="0,8">
                            <StackPanel>
                                <TextBlock Text="Desempenho máximo" FontSize="13"/>
                                <TextBlock Text="Mantém o sensor no modo mais rápido por um tempo depois de parar de mexer." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,4,0,0" IsEnabled="{Binding PerformanceState}">
                            <TextBlock Text="Duração" Style="{StaticResource Label}"/>
                            <ComboBox Width="140" HorizontalAlignment="Right" ItemsSource="{Binding PerformanceOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding PerformanceTime}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
