<Window x:Class="SpardaControl.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border Margin="24" Background="#17191E" BorderBrush="#2C3038" BorderThickness="1" CornerRadius="14" Effect="{StaticResource CardShadow}"
            MinWidth="380" MaxWidth="520" MouseLeftButtonDown="Drag">
        <StackPanel Margin="26,22,26,20">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="17"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"/>
            <ContentPresenter x:Name="BodyHost" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancelar" MinWidth="96" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="OkButton" Content="OK" MinWidth="96" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
