<UserControl x:Class="SpardaControl.Views.MacrosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding Macros}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Minhas macros" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Content="+ Nova" Style="{StaticResource PrimaryButton}" Padding="14,6" HorizontalAlignment="Right" Command="{Binding NewCommand}"/>
                </Grid>
                <TextBlock Text="Nenhuma macro ainda. Clique em “+ Nova” para criar." Margin="2,6,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" MaxHeight="440">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,2,0,0"/>
                                <Border CornerRadius="5" Background="{StaticResource AccentSoftBrush}" Padding="7,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding AssignedTo, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding AssignedTo}" FontSize="10.5" Foreground="#FF7A7F"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Excluir macro" Style="{StaticResource DangerButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding DeleteCommand}"
                        Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding HasEditor, Converter={StaticResource InvBoolToVis}}" MinHeight="300">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource IconMacro}" Stroke="{StaticResource TextMuteBrush}" StrokeThickness="1.6" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Selecione ou crie uma macro" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="Depois de salvar, atribua a macro a um botão na aba Botões." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NOME" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" FontSize="15" FontWeight="SemiBold" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="alterações não salvas" Foreground="{StaticResource WarningBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Salvar macro" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,18,0,0">
                    <Button Command="{Binding RecordCommand}" Margin="0,0,8,8" MinWidth="130">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Gravar teclas"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="Parar gravação"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Content="Inserir clique ▾" Margin="0,0,8,8" Click="InsertMouse_Click" IsEnabled="{Binding IsRecording, Converter={StaticResource InvBool}}"/>
                    <Button Content="Limpar tudo" Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}"/>
                </WrapPanel>

                <Border Background="#24141A" BorderBrush="#5A1C20" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,8"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Gravando… pressione as teclas no teclado. Clique em “Parar gravação” para terminar." FontSize="12.5" Foreground="#FF8A8F" TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,4,0,10">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoDelay}" HorizontalAlignment="Left">
                        <TextBlock Text="Gravar o tempo real entre as teclas" FontSize="13"/>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Atraso padrão" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="70" Text="{Binding DefaultDelay}" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="#121317" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6">
                    <Grid>
                        <TextBlock Text="Sem eventos. Use “Gravar teclas” ou “Inserir clique”." Margin="10,14" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Events.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="EventList" ItemsSource="{Binding Events}" MaxHeight="330" AlternationCount="100000">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
                                    <Setter Property="Padding" Value="8,2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource PlusOne}}"
                                                   Foreground="{StaticResource TextMuteBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Arrow" Grid.Column="1" Text="↓" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" HorizontalAlignment="Left" Background="#24272E" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KeyName}" FontWeight="SemiBold" FontSize="12.5"/>
                                        </Border>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="espera" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="64" Padding="6,3" Text="{Binding Delay, UpdateSourceTrigger=LostFocus}" TextAlignment="Center" FontSize="12"/>
                                            <TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                                            <Button Content="▲" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Click="Up_Click" Tag="{Binding}" ToolTip="Mover para cima"/>
                                            <Button Content="▼" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" Click="Down_Click" Tag="{Binding}" ToolTip="Mover para baixo"/>
                                            <Button Content="✕" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11"
                                                    Command="{Binding DataContext.RemoveEventCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Remover"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Press}" Value="False">
                                            <Setter TargetName="Arrow" Property="Text" Value="↑"/>
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding EventCountText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,4,0"/>

                <TextBlock Text="REPETIÇÃO" Style="{StaticResource Overline}" Margin="0,14,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Style="{StaticResource Radio}" GroupName="Cycle" Content="Repetir" Margin="0" VerticalAlignment="Center" IsChecked="{Binding CycleMode, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                    <TextBox Width="60" Margin="10,0,8,0" Text="{Binding CycleTimes}" TextAlignment="Center" VerticalAlignment="Center"
                             IsEnabled="{Binding CycleMode, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                    <TextBlock Text="vez(es)  (1 a 250)" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton Style="{StaticResource Radio}" GroupName="Cycle" Content="Repetir enquanto o botão estiver pressionado"
                             IsChecked="{Binding CycleMode, Converter={StaticResource IntEq}, ConverterParameter=254}"/>
                <RadioButton Style="{StaticResource Radio}" GroupName="Cycle" Content="Repetir até apertar qualquer botão"
                             IsChecked="{Binding CycleMode, Converter={StaticResource IntEq}, ConverterParameter=255}"/>
                <RadioButton Style="{StaticResource Radio}" GroupName="Cycle" Content="Repetir até apertar o mesmo botão de novo"
                             IsChecked="{Binding CycleMode, Converter={StaticResource IntEq}, ConverterParameter=253}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
