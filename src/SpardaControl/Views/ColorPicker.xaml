<UserControl x:Class="SpardaControl.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#1A1C22" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="12" Padding="16" Width="268" Effect="{StaticResource CardShadow}">
        <StackPanel>
            <TextBlock Text="CORES" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
            <ItemsControl x:Name="Presets">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Preset_Click" Tag="{Binding}" Width="32" Height="32" Margin="0,0,6,6" Padding="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="8" Background="{Binding Converter={StaticResource ColorToBrush}}" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="BorderBrush" Value="White"/>
                                            <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="PERSONALIZADA" Style="{StaticResource Overline}" Margin="0,10,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="R" Foreground="#FF6B6B" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="SR" Grid.Column="1" Maximum="255" ValueChanged="Rgb_Changed" Margin="4,2"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SR, StringFormat=0}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Grid.Row="1" Text="G" Foreground="#5BE08A" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="SG" Grid.Row="1" Grid.Column="1" Maximum="255" ValueChanged="Rgb_Changed" Margin="4,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=SG, StringFormat=0}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Grid.Row="2" Text="B" Foreground="#6BA8FF" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="SB" Grid.Row="2" Grid.Column="1" Maximum="255" ValueChanged="Rgb_Changed" Margin="4,2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=SB, StringFormat=0}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewSwatch" CornerRadius="8" Height="34" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                <TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0" LostFocus="Hex_Commit" KeyDown="Hex_KeyDown" CharacterCasing="Upper"/>
                <Button Grid.Column="2" Content="Aplicar" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Apply_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
