                    <TextBlock Canvas.Left="136" Canvas.Top="22" Text="R E D R A G O N" FontSize="8.5" FontWeight="SemiBold" Foreground="#555A64">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Keys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="300" Height="420"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding BadgeLeft}"/>
                                <Setter Property="Canvas.Top" Value="{Binding BadgeTop}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="26" Height="26" Cursor="Hand" MouseLeftButtonUp="Badge_Click" Tag="{Binding}" Background="Transparent">
                                    <Ellipse x:Name="Halo" Width="38" Height="38" Margin="-6" Fill="{StaticResource AccentBrush}" Opacity="0"/>
                                    <Ellipse Fill="{StaticResource AccentBrush}" Stroke="#FFFFFF" StrokeThickness="0"/>
                                    <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="Halo" Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Viewbox>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Tempo de debounce" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                           Text="Tempo mínimo entre cliques. Valores baixos deixam o clique mais rápido, mas podem gerar cliques duplos."/>
                <ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding DebounceOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Debounce}"/>
                <Border Margin="0,12,0,0" Background="#221A0E" BorderBrush="#4A3714" BorderThickness="1" CornerRadius="8" Padding="12,8"
                        Visibility="{Binding ShowDebounceWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarningBrush}"
                               Text="Com debounce baixo podem ocorrer cliques duplos. Se acontecer, aumente o valor."/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Backup e restauração" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                           Text="Salve a configuração do perfil atual em um arquivo ou volte às configurações de fábrica."/>
                <WrapPanel>
                    <Button Content="Exportar" Margin="0,0,8,8" Click="Export_Click" MinWidth="104"/>
                    <Button Content="Importar" Margin="0,0,8,8" Click="Import_Click" MinWidth="104"/>
                    <Button Content="Restaurar fábrica" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Click="Restore_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
