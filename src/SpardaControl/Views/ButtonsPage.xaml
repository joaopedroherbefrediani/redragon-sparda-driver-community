<UserControl x:Class="SpardaControl.Views.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Funções dos botões" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Content="Restaurar padrão" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="ResetButtons_Click"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Key_Click" Tag="{Binding}" Margin="0,4" HorizontalContentAlignment="Stretch" Padding="12,10"
                                    MouseEnter="Key_MouseEnter" MouseLeave="Key_MouseLeave">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Role}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="{Binding Function}" FontSize="14" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="5" Background="{StaticResource AccentSoftBrush}" Padding="7,2" Margin="0,0,12,0"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="personalizado" FontSize="10.5" Foreground="#FF7A7F"/>
                                        </Border>
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6" VerticalAlignment="Center"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,0"
                           Text="Clique em um botão para trocar a função. As mudanças são gravadas direto no mouse."/>
            </StackPanel>
        </Border>

