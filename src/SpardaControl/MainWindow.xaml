<Window x:Class="SpardaControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpardaControl.Views"
        Title="Sparda Control" Width="1220" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="#1A1C21" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,18,18,18" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,34">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentGradient}" Effect="{StaticResource AccentGlow}">
                        <Path Data="{StaticResource RedragonLogo}" Fill="White" Width="27" Height="27" Stretch="Uniform" Margin="0,1,0,0"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SPARDA" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17"/>
                        <TextBlock Text="CONTROL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#14161A" BorderBrush="#202329" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMuteBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Desconectado" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ModelTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ModelSubtitle}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="CONFIGURAÇÃO" Style="{StaticResource Overline}" Margin="8,0,0,8"/>
                    <RadioButton x:Name="NavButtons" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked" Tag="buttons">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconButtons}" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Botões" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="dpi">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDpi}" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="DPI e sensor" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="macros">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMacro}" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Macros" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="light"
                                 Visibility="{Binding HasLight, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLight}" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Iluminação" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.Background>
                <RadialGradientBrush Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#1A0E10" Offset="0"/>
                    <GradientStop Color="#0B0C0F" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="10">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar">
                    <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximizar">
                    <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Fechar">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
            </StackPanel>

            <Grid Margin="40,40,40,6">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Botões" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Escolha a função de cada botão do mouse." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <Border Margin="0,0,12,0" Background="#221A0E" BorderBrush="#4A3714" BorderThickness="1" CornerRadius="9" Height="36" Padding="12,0"
                            Visibility="{Binding IsAsleep, Converter={StaticResource BoolToVis}}"
                            ToolTip="O mouse desliga o rádio após alguns segundos parado para economizar bateria. Mexa o mouse para aplicar alterações.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Em repouso · mexa o mouse" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ComboBox Width="130" ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Profile}" IsEnabled="{Binding SupportsProfiles}" ToolTip="Perfil ativo no mouse"/>
                    <Border Margin="12,0,0,0" Background="#14161A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Height="36" Padding="12,0"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" ToolTip="Bateria do mouse">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="26" Height="13" VerticalAlignment="Center">
                                <Border BorderBrush="#7A808C" BorderThickness="1.3" CornerRadius="3" Width="23" HorizontalAlignment="Left"/>
                                <Border Width="2" Height="5" Background="#7A808C" CornerRadius="1" HorizontalAlignment="Right"/>
                                <Border Height="7" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2.5,0,0,0"
                                        Width="{Binding BatteryLevel, Converter={StaticResource BatteryWidth}}" Background="{Binding BatteryLevel, Converter={StaticResource BatteryBrush}}"/>
                            </Grid>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding BatteryLevel, Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                            <TextBlock Text=" ⚡" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding BatteryCharging, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="40,18,32,32"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <views:ButtonsPage x:Name="PageButtons"/>
                    <views:DpiPage x:Name="PageDpi" Visibility="Collapsed"/>
                    <views:MacrosPage x:Name="PageMacros" Visibility="Collapsed"/>
                    <views:LightingPage x:Name="PageLight" Visibility="Collapsed"/>
                    <views:SettingsPage x:Name="PageSettings" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" Visibility="{Binding IsReady, Converter={StaticResource InvBoolToVis}}">
                <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,34" Margin="0,0,0,60">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse Stroke="#2A2E36" StrokeThickness="3"/>
                            <Ellipse x:Name="Spinner" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeDashArray="9 30" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Path Data="{StaticResource IconButtons}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6" Width="24" Height="24" Stretch="Uniform"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H2}" FontSize="18" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"/>
                        <Button Content="Tentar novamente" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}" Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" CornerRadius="10"
                    Padding="16,10" Background="#1E2127" BorderBrush="#30343D" BorderThickness="1" IsHitTestVisible="False" Opacity="0"
                    Effect="{StaticResource CardShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastT" Y="12"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToastText}" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
